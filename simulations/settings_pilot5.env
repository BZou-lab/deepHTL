# settings_pilot5.env -- final nuisance settings of the paper (Table 3), read by submit_v18fix.sh
# and exported to cm_test_v18r2.R. Everything not listed keeps the script default
# (propensity net 256 / 120 / 20, L1 1e-5 at sigma 1 and 1e-3 at sigma 3, clip 0.05, K 5).
CM_SCREEN=2
CM_E_INPUT=raw
CM_MU_BATCH=128
CM_MU_EPOCH=500
CM_MU_PATIENCE=50
